{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "commonjs",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true
  },
  "include": [
    "playwright.config.ts",
    "config/**/*.ts",
    "components/**/*.ts",
    "pages/**/*.ts",
    "reporters/**/*.ts",
    "tests/**/*.ts"
  ]
}
